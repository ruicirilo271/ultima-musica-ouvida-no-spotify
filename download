<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#05070f">
  <meta name="description" content="Última música ouvida no Spotify por Rui Cirilo, com histórico, top semanal, letra e informação do artista.">
  <title>Rui Cirilo · Agora no Spotify</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ url_for('static', filename='styles.css') }}">
  <script defer src="{{ url_for('static', filename='app.js') }}"></script>
</head>
<body>
  <div class="ambient ambient-one" aria-hidden="true"></div>
  <div class="ambient ambient-two" aria-hidden="true"></div>
  <div class="equalizer" id="equalizer" aria-hidden="true"></div>

  <main class="app-shell">
    <header class="site-header">
      <div>
        <p class="eyebrow">HISTÓRICO SPOTIFY · VIA LAST.FM</p>
        <h1>Rui Cirilo <span>On Air</span></h1>
      </div>
      <div class="connection" id="connection">
        <span class="connection-dot"></span>
        <span id="connection-text">A ligar…</span>
      </div>
    </header>

    <section class="dashboard" aria-label="Painel musical">
      <article class="now-card glass">
        <div class="cover-wrap">
          <img
            id="album-cover"
            src="{{ url_for('static', filename='default-cover.svg') }}"
            alt="Capa da música"
            width="720"
            height="720"
          >
          <div class="cover-glow" aria-hidden="true"></div>
          <div class="live-badge" id="live-badge">
            <span></span>
            <strong id="live-label">A CARREGAR</strong>
          </div>
        </div>

        <div class="now-content">
          <p class="section-label">EM DESTAQUE</p>
          <h2 id="track-name">A procurar a última música…</h2>
          <p class="artist-name" id="artist-name">Spotify de {{ username }}</p>
          <p class="album-name" id="album-name"></p>
          <p class="heard-at" id="heard-at"></p>

          <div class="actions">
            <a class="primary-button disabled" id="spotify-link" href="#" target="_blank" rel="noopener noreferrer" aria-disabled="true">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.58 14.42a.62.62 0 0 1-.86.2c-2.35-1.43-5.3-1.76-8.78-.96a.63.63 0 0 1-.28-1.22c3.8-.87 7.07-.5 9.72 1.12.3.18.39.57.2.86Zm1.23-2.73a.78.78 0 0 1-1.08.26c-2.69-1.65-6.8-2.13-9.98-1.17a.78.78 0 1 1-.45-1.5c3.64-1.1 8.17-.56 11.25 1.33.37.23.49.71.26 1.08Zm.1-2.84C14.68 8.93 9.36 8.75 6.28 9.68a.94.94 0 0 1-.54-1.8c3.54-1.07 9.42-.85 13.13 1.35a.94.94 0 0 1-.96 1.62Z"/></svg>
              Abrir no Spotify
            </a>
            <a class="ghost-button disabled" id="lastfm-link" href="#" target="_blank" rel="noopener noreferrer" aria-disabled="true">Ver no Last.fm</a>
          </div>
        </div>

        <div class="detail-grid">
          <section class="detail-panel lyrics-panel">
            <div class="panel-heading">
              <div>
                <p class="section-label">LETRA</p>
                <h3>Palavras da música</h3>
              </div>
              <span class="source-label" id="lyrics-source"></span>
            </div>
            <div class="lyrics-content scroll-area" id="lyrics" aria-live="polite">
              <p class="muted">A letra aparecerá quando a música for identificada.</p>
            </div>
          </section>

          <section class="detail-panel artist-panel">
            <div class="panel-heading">
              <div>
                <p class="section-label">ARTISTA</p>
                <h3>Sobre quem estás a ouvir</h3>
              </div>
            </div>
            <div id="artist-info" aria-live="polite">
              <p class="muted">A informação do artista aparecerá aqui.</p>
            </div>
          </section>
        </div>
      </article>

      <aside class="side-column">
        <section class="list-card glass">
          <div class="card-heading">
            <div>
              <p class="section-label">ÚLTIMOS 7 DIAS</p>
              <h2>Top 10</h2>
            </div>
            <span class="counter">10</span>
          </div>
          <ol class="track-list top-list" id="top-tracks" aria-live="polite">
            <li class="loading-row">A carregar o top semanal…</li>
          </ol>
        </section>

        <section class="list-card glass">
          <div class="card-heading">
            <div>
              <p class="section-label">HISTÓRICO</p>
              <h2>Últimas ouvidas</h2>
            </div>
            <button class="icon-button" id="refresh-button" type="button" title="Atualizar agora" aria-label="Atualizar agora">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.65 6.35A8 8 0 1 0 19.73 14h-2.08A6 6 0 1 1 16.2 7.8L13 11h8V3l-3.35 3.35Z"/></svg>
            </button>
          </div>
          <ul class="track-list recent-list" id="recent-tracks" aria-live="polite">
            <li class="loading-row">A carregar o histórico…</li>
          </ul>
        </section>
      </aside>
    </section>

    <footer>
      <p>Atualização automática a cada 20 segundos</p>
      <p id="last-update">Ainda não atualizado</p>
    </footer>
  </main>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</body>
</html>
